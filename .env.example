# virtubooth configuration. Copy to .env and keep that file secret.
#
# Fresh random secrets, either way:
#   docker compose run --rm -T app virtubooth gen-env > .env
#   cd backend && uv run virtubooth gen-env > ../.env      (or: make dev, which does it)
# (gen-env prints the essentials; add anything else from this file by hand.)
# Every variable is explained in docs/DEPLOY.md#settings.
#
# Format: KEY=value, no spaces around "=". Quote values that contain spaces
# (VB_PARTY_NAME="Lenas 30."): that works for Compose and for `. ./.env`.
# Compose expands ${...} inside values, so avoid "$" in passwords (or
# single-quote them). Empty values mean "use the default".

# ------------------------------------------------------------------ secrets

# Optional. Read only on the first start (a new database, or the first start
# after the update that brought QR codes): it becomes the token of QR code 1,
# the secret in its URL (https://host/...?t=<token>). Empty = a generated one.
# 16-128 characters of A-Z a-z 0-9 _ -. After that, QR codes and their tokens
# are managed in Admin -> QR-Codes; changing this value only logs a warning.
VB_PARTY_TOKEN=

# The first password for /admin. At least 12 characters; use 16+ random ones
# (the log warns otherwise; gen-env makes one). Once the password is changed in
# the admin (Einstellungen), only that one works; back to this one:
#   virtubooth reset-admin-password --from-env
# While no admin password is stored, changing this ends every admin session.
VB_ADMIN_PASSWORD=

# Signs cookies (party access, guest device id). At least 32 characters.
# Changing it forgets every guest's device (they see the join sheet again and
# get a new pseudonym) and logs everyone out.
VB_SECRET_KEY=

# ------------------------------------------------------------------- party

# The default event name: shown on the start page, in the join sheet
# ("Willkommen bei <name>!"), on the QR sheet and the posters. The admin can
# override it (Einstellungen -> Eventname); that one wins until reset.
VB_PARTY_NAME=Party

# Instagram account you may post photos to, named in the join sheet,
# e.g. @ourparty. Empty = not mentioned.
VB_INSTAGRAM_ACCOUNT=

# Public URL guests open, without a trailing slash, e.g.
# https://party.example.com. The QR codes use it (admin QR-Codes and Export
# "QR-Bogen", python -m virtubooth.tools.qr).
VB_PUBLIC_BASE_URL=http://localhost:8000

# Timezone for the timestamps in photo and export file names.
VB_TIMEZONE=Europe/Berlin

# Stored with every guest's consent. Bump it (2, 3, ...) when you change what
# guests agree to (e.g. to record the sentence about the per-guest statistics
# as a new text version); devices that already accepted are not asked again.
VB_CONSENT_VERSION=1

# Comma-separated extension ids to enable, in this order, e.g. beer,booth,wall
# (wall = the Live-Wall at /livewall). Empty = every installed extension.
VB_EXTENSIONS=

# ------------------------------------------------------ Live-Wall analysis

# The app starts the Live-Wall's photo analysis worker itself. off = never
# (e.g. the worker runs in another container on the same /data volume).
# VB_WALL_WORKER=off

# Where the analysis models are looked up first and where `models fetch`
# writes (default <data>/wall/models; the ML image also has /opt/vb-models).
# VB_WALL_MODELS_DIR=

# Threads per inference in the worker; 0 = all cores. Lower it if the booth
# lags on a Raspberry Pi.
# VB_WALL_THREADS=3

# ------------------------------------------------------ HTTPS / reverse proxy

# Mark cookies "Secure": auto (if the request came in over https), true, false.
# Behind a TLS reverse proxy set true (or trust the proxy below so auto works).
VB_COOKIE_SECURE=auto

# Proxies whose X-Forwarded-For / X-Forwarded-Proto headers are trusted:
# comma-separated IPs or CIDR ranges. Default 127.0.0.1. In Docker, a proxy on
# the host or in another container connects from a Docker network address:
# 172.16.0.0/12 covers Docker's default bridge networks. Without this every
# guest shares the proxy's IP for rate limits and logs. Prefer the proxy's
# exact address (gateway or container IP) over the whole range, and never use
# "*" (refused at startup): anyone reaching the port could then pick their own
# IP for rate limits.
# VB_FORWARDED_ALLOW_IPS=172.16.0.0/12

# Extra origins accepted by the CSRF check (comma-separated, compared exactly:
# scheme, host and port), e.g. https://party.example.com. VB_PUBLIC_BASE_URL is
# always accepted, so this is only needed for additional hostnames, or to allow
# an http:// origin on an https deployment.
VB_ALLOWED_ORIGINS=

# ------------------------------------------------------------------- limits
# Rate limits are per process and reset on restart. Guests on the same Wi-Fi
# (or carrier NAT) share one IP: raise the per-IP limits for a big crowd on
# venue Wi-Fi.

# Max size of one uploaded photo in bytes (default 8000000).
VB_MAX_UPLOAD_BYTES=
# Uploads per guest per minute (default 10).
VB_UPLOADS_PER_USER_PER_MIN=
# Valid uploads per IP address per minute (default 180; venue WiFi shares one IP).
VB_UPLOADS_PER_IP_PER_MIN=
# Uploads per minute across the whole party (default 300).
VB_UPLOADS_GLOBAL_PER_MIN=
# New guest identities (joined) per IP per 10 minutes (default 120).
VB_NEW_USERS_PER_IP_PER_10MIN=
# QR scans per IP per 10 minutes from browsers without a visitor id that are
# counted (default 120). Over it they still get in, they are just not counted
# under „Gescannt“ until they join.
VB_SCANS_PER_IP_PER_10MIN=
# Photos (not deleted) one guest may keep, over every activity (default 300; 0 = no limit).
VB_MAX_PHOTOS_PER_GUEST=
# Uploads are refused while the data dir's disk has less free space, in MB (default 2048; 0 = off).
VB_MIN_FREE_MB=
# API requests per identified guest device per minute (default 300).
VB_API_REQUESTS_PER_GUEST_PER_MIN=
# API requests per IP per minute from devices without an identity yet (default 1200).
VB_API_REQUESTS_PER_IP_PER_MIN=
# Admin login lifetime in hours (default 12).
VB_ADMIN_SESSION_HOURS=

# ------------------------------------------------------------ server (local)
# Docker sets these itself (both compose files pin VB_DATA_DIR=/data,
# VB_HOST=0.0.0.0, VB_PORT=8000 and VB_WEB_DIR=/app/web inside the container);
# they only matter for `virtubooth serve` / `make dev` on your machine.

# Where the SQLite database and the photos live. Must not be empty.
VB_DATA_DIR=./data
# Interface and port uvicorn listens on. Leave commented out for the defaults
# (empty values fall back to the defaults).
# VB_HOST=127.0.0.1
# VB_PORT=8000
# The built frontend (Vite's dist: index.html, admin.html, gate.html, assets/).
# Default: frontend/dist of this checkout (make build-web). Docker pins
# /app/web, the build inside the image (compose.yaml enforces it).
# Without one the server refuses to start, unless VB_DEV=1.
# VB_WEB_DIR=
# 1 = development: without VB_WEB_DIR, serve placeholder pages (the API works
# as usual, e.g. behind `pnpm dev`). Relaxes nothing security-relevant.
# VB_DEV=

# ---------------------------------------------------- Docker Compose only
# Read by compose.yaml (not by the app).

# Host address and port: 127.0.0.1:8000 (only this machine: a reverse proxy on
# the host; the safe default, Docker's published ports bypass ufw/firewalld) or
# 8000 (all interfaces, only if a proxy on another machine must reach it).
VB_PUBLISH_PORT=127.0.0.1:8000
# Image name:tag that `docker compose build` produces / `up` runs.
VB_IMAGE=virtubooth:local
# Container limits. VB_CPU_LIMIT must not exceed the host's CPU count.
VB_CPU_LIMIT=1.0
VB_MEM_LIMIT=1g
