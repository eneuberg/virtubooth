# virtubooth configuration. Copy to .env and keep that file secret.
#
# Fresh random secrets, either way:
#   docker compose run --rm -T app virtubooth gen-env > .env
#   uv run virtubooth gen-env > .env
# (gen-env prints the essentials; add anything else from this file by hand.)
#
# Format: KEY=value, no spaces around "=". Quote values that contain spaces
# (VB_PARTY_NAME="Lenas 30."): that works for Compose and for `. ./.env`.
# Compose expands ${...} inside values, so avoid "$" in passwords (or
# single-quote them). Empty values mean "use the default".

# ----------------------------------------------------------------- required

# Secret part of every QR code URL (https://host/...?t=<token>). Without it,
# every page shows "Scan den QR-Code" and every API call returns 404.
# 16-128 characters of A-Z a-z 0-9 _ -. Changing it locks out every guest
# until they scan a new QR code.
VB_PARTY_TOKEN=

# Password for /admin. At least 12 characters. Changing it ends every admin
# session.
VB_ADMIN_PASSWORD=

# Signs cookies (party access, guest device id). At least 32 characters.
# Changing it forgets every guest's device (they see the consent banner again
# and get a new pseudonym) and logs everyone out.
VB_SECRET_KEY=

# ------------------------------------------------------------------- party

# Shown on the home page and in the consent banner ("Willkommen bei <name>!").
VB_PARTY_NAME=Party

# Instagram account you may post photos to, shown in the consent banner,
# e.g. @ourparty. Empty = not mentioned.
VB_INSTAGRAM_ACCOUNT=

# Public URL guests open, without a trailing slash. The QR code tool bakes it
# into the printed codes, e.g. https://party.example.com
VB_PUBLIC_BASE_URL=http://localhost:8000

# Timezone for the timestamps in photo file names.
VB_TIMEZONE=Europe/Berlin

# Stored with every guest's consent. Bump it (2, 3, ...) when you change what
# guests agree to; devices that already accepted are not asked again.
VB_CONSENT_VERSION=1

# Comma-separated extension ids to enable, in this order, e.g. beer,booth.
# Empty = every installed extension.
VB_EXTENSIONS=

# ------------------------------------------------------ HTTPS / reverse proxy

# Mark cookies "Secure": auto (if the request came in over https), true, false.
# Behind a TLS reverse proxy set true (or trust the proxy below so auto works).
VB_COOKIE_SECURE=auto

# Proxies whose X-Forwarded-For / X-Forwarded-Proto headers are trusted:
# comma-separated IPs or CIDR ranges. Default 127.0.0.1. In Docker, a proxy on
# the host or in another container connects from a Docker network address:
# 172.16.0.0/12 covers Docker's default bridge networks. Without this every
# guest shares the proxy's IP for rate limits and logs. "*" trusts anyone:
# only if nothing but the proxy can reach the app port.
# VB_FORWARDED_ALLOW_IPS=172.16.0.0/12

# Extra origins accepted by the CSRF check (comma-separated), e.g.
# https://party.example.com. Only needed if the proxy does not pass the
# original Host header through (Caddy and Traefik do; nginx needs
# "proxy_set_header Host $host;").
VB_ALLOWED_ORIGINS=

# ------------------------------------------------------------------- limits
# Rate limits are per process and reset on restart. Guests on the same Wi-Fi
# (or carrier NAT) share one IP: raise the per-IP limits for a big crowd on
# venue Wi-Fi.

# Max size of one uploaded photo in bytes (default 8000000).
VB_MAX_UPLOAD_BYTES=
# Uploads per guest per minute (default 10).
VB_UPLOADS_PER_USER_PER_MIN=
# Uploads per IP address per minute (default 60).
VB_UPLOADS_PER_IP_PER_MIN=
# Uploads per minute across the whole party (default 300).
VB_UPLOADS_GLOBAL_PER_MIN=
# New guest identities (consent accepted) per IP per 10 minutes (default 120).
VB_NEW_USERS_PER_IP_PER_10MIN=
# All API requests per IP per minute (default 1200; a whole party on one WiFi shares an IP).
VB_API_REQUESTS_PER_IP_PER_MIN=
# Admin login lifetime in hours (default 12).
VB_ADMIN_SESSION_HOURS=

# ------------------------------------------------------------ server (local)
# Docker sets these itself (compose.yaml pins VB_DATA_DIR=/data, VB_HOST=0.0.0.0,
# VB_PORT=8000 inside the container); they only matter for `uv run virtubooth serve`.

# Where the SQLite database and the photos live. Must not be empty.
VB_DATA_DIR=./data
# Interface and port uvicorn listens on. Leave commented out for the defaults
# (empty values fall back to the defaults).
# VB_HOST=127.0.0.1
# VB_PORT=8000

# ---------------------------------------------------- Docker Compose only
# Read by compose.yaml (not by the app).

# Host port, optionally with an address: 8000 (all interfaces) or
# 127.0.0.1:8000 (only this machine, e.g. for a reverse proxy on the host;
# Docker's published ports bypass ufw/firewalld).
VB_PUBLISH_PORT=8000
# Image name:tag that `docker compose build` produces / `up` runs.
VB_IMAGE=virtubooth:local
# Container limits. VB_CPU_LIMIT must not exceed the host's CPU count.
VB_CPU_LIMIT=1.0
VB_MEM_LIMIT=1g
