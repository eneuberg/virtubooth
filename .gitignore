# runtime data (SQLite + photos): never commit. Anchored, so source folders
# named "data" (e.g. under frontend/src) are not ignored by accident.
/data/
backend/data/
*.db
*.db-wal
*.db-shm

# secrets (.env.example is not matched)
.env
*.env

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# frontend (frontend/.gitignore has the same, for tools run inside frontend/)
frontend/node_modules/
frontend/dist/
frontend/dist-gallery/
*.tsbuildinfo

# test output
test-results/
playwright-report/

# filter lists downloaded by tests/unit/test_core_blockers.py (VB_BLOCKLISTS=.blocklists)
.blocklists/

# outputs of the CLI tools when run with --out in the repo root
/*.mp4
/*.tar.gz
/qr/
/qr-sheet.*
/export/
/exports/

# agent worktrees
.worktrees/
