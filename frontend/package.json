{
  "name": "virtubooth-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/precompress.mjs dist && node scripts/check-names.mjs dist",
    "build:gallery": "vite build --mode gallery && node scripts/check-names.mjs dist-gallery",
    "preview": "vite preview",
    "serve:dist": "node scripts/serve-dist.mjs",
    "lint": "oxlint --type-aware --deny-warnings && prettier --check .",
    "fmt": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.gen.ts"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/doto": "5.3.0",
    "@fontsource/bungee": "5.3.0",
    "@tanstack/react-query": "5.104.2",
    "lucide-react": "1.55.0",
    "openapi-fetch": "0.17.0",
    "pdfjs-dist": "6.4.299",
    "qr": "0.7.2",
    "react": "19.3.0",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "wouter": "3.13.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@react-aria/optimize-locales-plugin": "2.1.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "happy-dom": "21.0.1",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tailwindcss-react-aria-components": "2.2.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
